modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8082
externalPort = 80

[userenv]

[userenv.shared]
TEST_SUPABASE_URL = "https://zietsxqqsplnutnyzivb.supabase.co"
TEST_SUPABASE_DB_HOST = "aws-0-eu-west-2.pooler.supabase.com"
TEST_SUPABASE_DB_PORT = "5432"
PROD_SUPABASE_DB_HOST = "aws-1-eu-west-1.pooler.supabase.com"
PROD_SUPABASE_DB_PORT = "5432"
PROD_SUPABASE_DB_USER = "postgres.olryipikrvhmxvqlmoxo"
